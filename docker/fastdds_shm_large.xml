<?xml version="1.0" encoding="UTF-8"?>
<!--
  Fast DDS profile for same-host runs with large point clouds (used by scripts/node_bench.sh).
  With Fast DDS defaults a best-effort cloud of 0.9 MB or more is mostly dropped here: the default
  shared-memory segment is 512 KB, smaller than one sample, and the UDP fallback is capped by the
  Docker VM's 208 KB socket buffer limit (net.core.rmem_max = 212992). This profile uses shared
  memory only, with a 16 MB segment (one 1280x720 cloud is 11 MB). Two processes need 2 x 16 MB,
  which fits Docker's default 64 MB /dev/shm.
  Enable with FASTRTPS_DEFAULT_PROFILES_FILE=<this file> and RMW_IMPLEMENTATION=rmw_fastrtps_cpp.
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>shm_large</transport_id>
      <type>SHM</type>
      <segment_size>16777216</segment_size>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="shm_large_participant" is_default_profile="true">
    <rtps>
      <userTransports><transport_id>shm_large</transport_id></userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
